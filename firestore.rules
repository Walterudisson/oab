rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Banco oficial de questões: leitura pública; escrita somente via Admin SDK.
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // Espelhos oficiais: disponíveis apenas para usuários autenticados.
    // A interface de correção poderá liberá-los após a tentativa do aluno.
    match /mirrors/{questionId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Dados privados do estudante.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
